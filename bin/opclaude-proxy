#!/usr/bin/env bash
# Manages the local litellm proxy that routes Claude Code through opencode
# Zen models. See ../README.md and ../FIX.md.
#
# Also manages the relay on :4001 (opclaude_relay.py) that sits in front of
# plain `claude` once `opclaude relay enable` is on.
#
# Usage: opclaude-proxy start|stop|restart|status|ensure|build
set -uo pipefail

# Resolve the real repo root even when this script is symlinked onto PATH.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL_SCRIPT="$(readlink "$SCRIPT_PATH" 2>/dev/null || echo "$SCRIPT_PATH")"
case "$REAL_SCRIPT" in
  /*) : ;;
  *) REAL_SCRIPT="$(dirname "$SCRIPT_PATH")/$REAL_SCRIPT" ;;
esac
REPO_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"

STATE_DIR="$HOME/.config/opclaude"
ENV_FILE="$STATE_DIR/.env"
PID_FILE="$STATE_DIR/proxy.pid"
LOG_FILE="$STATE_DIR/proxy.log"
PORT=4000
HOST=127.0.0.1
MODELS_FILE="${OPCLAUDE_MODELS:-$HOME/.opclaude/models.yaml}"
RELAY_PORT=4001
RELAY_PID_FILE="$STATE_DIR/relay.pid"
RELAY_OUT="$STATE_DIR/relay.out"
GENERATED_CONFIG="$REPO_DIR/config.generated.yaml"

# Run opclaude_models.py under litellm's own interpreter (it has PyYAML).
models_py() {
  local py
  py="$(head -n 1 "$(command -v litellm)" 2>/dev/null | sed -n 's/^#!//p')"
  [ -x "$py" ] || py=python3
  "$py" "$REPO_DIR/opclaude_models.py" "$@"
}

# True when models.yaml or config.yaml changed since the last build.
config_stale() {
  [ ! -f "$GENERATED_CONFIG" ] || [ ! -f "$MODELS_FILE" ] ||
    [ "$MODELS_FILE" -nt "$GENERATED_CONFIG" ] || [ "$REPO_DIR/config.yaml" -nt "$GENERATED_CONFIG" ]
}

mkdir -p "$STATE_DIR"

if [ ! -f "$ENV_FILE" ]; then
  echo "opclaude is not set up yet. Run install.sh from $REPO_DIR first." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

is_running() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      if curl -fsS -o /dev/null --max-time 2 "http://$HOST:$PORT/health/liveliness" 2>/dev/null; then
        return 0
      fi
    fi
  fi
  return 1
}

relay_running() {
  [ -f "$RELAY_PID_FILE" ] && kill -0 "$(cat "$RELAY_PID_FILE" 2>/dev/null)" 2>/dev/null &&
    curl -fsS -o /dev/null --max-time 2 "http://$HOST:$RELAY_PORT/_relay/health" 2>/dev/null
}

relay_start() {
  if relay_running; then
    echo "opclaude relay already running (pid $(cat "$RELAY_PID_FILE"))."
    return 0
  fi
  rm -f "$RELAY_PID_FILE"
  echo "Starting opclaude relay on http://$HOST:$RELAY_PORT ..."
  nohup python3 "$REPO_DIR/opclaude_relay.py" >> "$RELAY_OUT" 2>&1 &
  echo $! > "$RELAY_PID_FILE"
  local waited=0
  while [ "$waited" -lt 10 ]; do
    if relay_running; then
      echo "opclaude relay is up (pid $(cat "$RELAY_PID_FILE"))."
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "opclaude relay did not come up within 10s. Last 30 lines of $RELAY_OUT:" >&2
  tail -n 30 "$RELAY_OUT" >&2
  return 1
}

relay_stop() {
  local pid
  pid="$(cat "$RELAY_PID_FILE" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    echo "Stopped opclaude relay (pid $pid)."
  else
    echo "opclaude relay is not running."
  fi
  rm -f "$RELAY_PID_FILE"
}

relay_status() {
  if relay_running; then
    echo "opclaude relay is running (pid $(cat "$RELAY_PID_FILE")) on http://$HOST:$RELAY_PORT"
  else
    echo "opclaude relay is not running."
  fi
}

# The relay starts first but its failure never blocks LiteLLM; it only sets
# the exit status so start/restart report it.
start() {
  local relay_rc=0
  relay_start || relay_rc=$?
  litellm_start || return 1
  return "$relay_rc"
}

litellm_start() {
  if is_running; then
    echo "opclaude proxy already running (pid $(cat "$PID_FILE"))."
    return 0
  fi
  rm -f "$PID_FILE"
  models_py build || return 1
  echo "Starting opclaude proxy on http://$HOST:$PORT ..."
  (
    cd "$REPO_DIR" || exit 1
    nohup litellm --config "$GENERATED_CONFIG" --host "$HOST" --port "$PORT" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  )

  local waited=0
  while [ "$waited" -lt 30 ]; do
    if curl -fsS -o /dev/null --max-time 2 "http://$HOST:$PORT/health/liveliness" 2>/dev/null; then
      echo "opclaude proxy is up (pid $(cat "$PID_FILE"))."
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done

  echo "opclaude proxy did not come up within 30s. Last 30 lines of $LOG_FILE:" >&2
  tail -n 30 "$LOG_FILE" >&2
  return 1
}

stop() {
  relay_stop
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
      echo "Stopped opclaude proxy (pid $pid)."
    fi
    rm -f "$PID_FILE"
  else
    echo "opclaude proxy is not running."
  fi
}

status() {
  relay_status
  if is_running; then
    echo "opclaude proxy is running (pid $(cat "$PID_FILE")) on http://$HOST:$PORT"
  else
    echo "opclaude proxy is not running."
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  ensure)
    if ! is_running || ! relay_running; then
      start || is_running
    elif config_stale; then
      echo "models changed, reloading opclaude proxy ..."
      stop; sleep 1; start
    fi
    ;;
  build) models_py build ;;
  *)
    echo "Usage: opclaude-proxy start|stop|restart|status|ensure|build" >&2
    exit 1
    ;;
esac
