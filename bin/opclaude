#!/usr/bin/env bash
# Run Claude Code through opencode Zen models (Kimi, Qwen, DeepSeek, GLM,
# Minimax, gpt-5.3-codex) via a local litellm proxy.
#
# Starts the proxy on first use if it isn't already running, then execs
# claude in this same terminal. See ../README.md.
set -uo pipefail

# Resolve the real repo root even when this script is symlinked onto PATH.
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL_SCRIPT="$(readlink "$SCRIPT_PATH" 2>/dev/null || echo "$SCRIPT_PATH")"
case "$REAL_SCRIPT" in
  /*) : ;;
  *) REAL_SCRIPT="$(dirname "$SCRIPT_PATH")/$REAL_SCRIPT" ;;
esac
REPO_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"

STATE_DIR="$HOME/.config/opclaude"
ENV_FILE="$STATE_DIR/.env"

# Run opclaude_models.py under litellm's own interpreter (it has PyYAML).
models_py() {
  local py
  py="$(head -n 1 "$(command -v litellm)" 2>/dev/null | sed -n 's/^#!//p')"
  [ -x "$py" ] || py=python3
  "$py" "$REPO_DIR/opclaude_models.py" "$@"
}

reload_proxy_if_running() {
  if command -v opclaude-proxy >/dev/null 2>&1 && opclaude-proxy status | grep -q "opclaude proxy is running"; then
    opclaude-proxy restart
  fi
}

if [ "${1:-}" = "models" ]; then
  case "${2:-}" in
    add)
      shift 2
      models_py add "$@" && reload_proxy_if_running
      exit $?
      ;;
    edit)
      file="$(models_py path)" || exit 1
      before="$(cksum < "$file")"
      ${VISUAL:-${EDITOR:-vi}} "$file"
      if [ "$(cksum < "$file")" != "$before" ]; then
        models_py build >/dev/null && reload_proxy_if_running
      fi
      exit $?
      ;;
    path)
      models_py path
      exit $?
      ;;
    -h|--help|help)
      echo "opclaude models [provider]                    list models, grouped by provider"
      echo "opclaude models add <provider> <id> [k=v ...]  e.g. add openrouter qwen/qwen3.7-coder context=256K"
      echo "opclaude models edit                          open models.yaml in \$EDITOR"
      echo "opclaude models path                          print models.yaml location"
      exit 0
      ;;
    *)
      models_py list ${2:+"$2"}
      exit $?
      ;;
  esac
fi

if [ "${1:-}" = "set-key" ]; then
  if [ ! -f "$ENV_FILE" ]; then
    echo "opclaude is not set up yet. Run install.sh first." >&2
    exit 1
  fi

  key_name="${2:-opencode}"

  case "$key_name" in
    meta)
      var="META_API_KEY"
      prompt="Enter your Meta AI API key (META_API_KEY): "
      ;;
    opencode|"")
      var="OPENCODE_API_KEY"
      prompt="Enter your new opencode API key (OPENCODE_API_KEY): "
      ;;
    openrouter)
      var="OPENROUTER_API_KEY"
      prompt="Enter your OpenRouter API key (OPENROUTER_API_KEY): "
      ;;
    github)
      var="GITHUB_API_KEY"
      prompt="Enter your GitHub Models API key (GITHUB_API_KEY): "
      ;;
    *)
      echo "Unknown key: $key_name. Use: opencode (default), meta, openrouter, github" >&2
      exit 1
      ;;
  esac

  new_val="${3:-}"
  if [ -z "$new_val" ]; then
    read -r -s -p "$prompt" new_val
    echo
  fi
  if [ -z "$new_val" ]; then
    echo "No key entered, nothing changed." >&2
    exit 1
  fi

  python3 - "$ENV_FILE" "$var" "$new_val" <<'PY'
import os, sys

path = sys.argv[1]
key = sys.argv[2]
value = sys.argv[3]

# Read existing env vars from file
env = {}
try:
    with open(path) as f:
        for line in f:
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                env[k] = v
except FileNotFoundError:
    pass

# Ensure LITELLM_MASTER_KEY exists (generate if missing)
if "LITELLM_MASTER_KEY" not in env:
    env["LITELLM_MASTER_KEY"] = "sk-" + os.urandom(32).hex()

# Update the target key
env[key] = value

# Write back preserving existing keys
lines = []
for k in ("OPENCODE_API_KEY", "META_API_KEY", "LITELLM_MASTER_KEY", "GITHUB_API_KEY", "OPENROUTER_API_KEY"):
    v = env.get(k)
    if v:
        lines.append(f"{k}={v}")
lines.append("")  # trailing newline

umask = os.umask(0o077)
try:
    with open(path, "w") as f:
        f.write("\n".join(lines))
finally:
    os.umask(umask)

print(f"Updated {key} in {path}.")
PY

  if command -v opclaude-proxy >/dev/null 2>&1; then
    opclaude-proxy restart
  fi
  exit 0
fi

CLAUDE_SETTINGS_FILE="$HOME/.claude/settings.json"

if [ "${1:-}" = "enable-ide" ]; then
  if [ ! -f "$ENV_FILE" ]; then
    echo "opclaude is not set up yet. Run install.sh first." >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to safely edit $CLAUDE_SETTINGS_FILE without clobbering it. Install python3 and re-run." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$ENV_FILE"

  mkdir -p "$(dirname "$CLAUDE_SETTINGS_FILE")"
  OPCLAUDE_BASE_URL="http://127.0.0.1:4000" OPCLAUDE_AUTH_TOKEN="$LITELLM_MASTER_KEY" \
    python3 - "$CLAUDE_SETTINGS_FILE" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        settings = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    settings = {}
settings.setdefault("env", {})
settings["env"]["ANTHROPIC_BASE_URL"] = os.environ["OPCLAUDE_BASE_URL"]
settings["env"]["ANTHROPIC_AUTH_TOKEN"] = os.environ["OPCLAUDE_AUTH_TOKEN"]
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY

  echo "Added ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN to $CLAUDE_SETTINGS_FILE."
  echo "Every claude session now routes through opclaude -- CLI, VSCode, and JetBrains alike."
  echo "Run 'opclaude disable-ide' to revert."
  echo
  opclaude-proxy ensure
  echo "(the proxy must keep running for IDE sessions to work -- they won't auto-start it like the opclaude CLI wrapper does)"
  exit 0
fi

if [ "${1:-}" = "disable-ide" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to safely edit $CLAUDE_SETTINGS_FILE without clobbering it. Install python3 and re-run." >&2
    exit 1
  fi
  if [ ! -f "$CLAUDE_SETTINGS_FILE" ]; then
    echo "$CLAUDE_SETTINGS_FILE does not exist, nothing to do."
    exit 0
  fi
  python3 - "$CLAUDE_SETTINGS_FILE" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    settings = json.load(f)
env = settings.get("env", {})
env.pop("ANTHROPIC_BASE_URL", None)
env.pop("ANTHROPIC_AUTH_TOKEN", None)
if env:
    settings["env"] = env
else:
    settings.pop("env", None)
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  echo "Removed ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN from $CLAUDE_SETTINGS_FILE."
  echo "claude (CLI, VSCode, JetBrains) will go back to talking to Anthropic directly."
  exit 0
fi

if [ "${1:-}" = "relay" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to safely edit ~/.zshrc. Install python3 and re-run." >&2
    exit 1
  fi
  ZSHRC="$HOME/.zshrc"
  case "${2:-}" in
    enable|disable)
      if ! python3 - "$ZSHRC" "$2" <<'PY'
import re, shutil, sys
from pathlib import Path
path, action = Path(sys.argv[1]), sys.argv[2]
start, end = "# >>> opclaude relay >>>", "# <<< opclaude relay <<<"
block = start + """
claude() {
  if [ -z "${ANTHROPIC_BASE_URL:-}" ] && curl -fsS -o /dev/null --max-time 0.3 http://127.0.0.1:4001/_relay/health 2>/dev/null; then
    ANTHROPIC_BASE_URL=http://127.0.0.1:4001 command claude "$@"
  else
    command claude "$@"
  fi
}
""" + end
text = path.read_text() if path.exists() else ""
pattern = re.compile(re.escape(start) + r".*?" + re.escape(end) + r"\n?", re.S)
if action == "enable":
    if path.exists():
        shutil.copy2(path, str(path) + ".opclaude.bak")
    if pattern.search(text):
        text = pattern.sub(lambda _: block + "\n", text)
    else:
        text += ("" if text.endswith("\n") or not text else "\n") + block + "\n"
else:
    text = pattern.sub("", text)
path.write_text(text)
PY
      then
        exit 1
      fi
      if [ "$2" = enable ]; then
        echo "Added the opclaude relay block to $ZSHRC (backup: $ZSHRC.opclaude.bak)."
      else
        echo "Removed the opclaude relay block from $ZSHRC."
      fi
      echo "Open a new shell or \`source ~/.zshrc\`."
      exit 0
      ;;
    status)
      if grep -qF "# >>> opclaude relay >>>" "$ZSHRC" 2>/dev/null; then
        echo "relay block present in $ZSHRC"
      else
        echo "relay block absent from $ZSHRC"
      fi
      opclaude-proxy status
      exit $?
      ;;
    *)
      echo "Usage: opclaude relay enable|disable|status" >&2
      exit 1
      ;;
  esac
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "Claude Code CLI ('claude') not found on PATH. Run install.sh again, or install it yourself:" >&2
  echo "  npm install -g @anthropic-ai/claude-code" >&2
  exit 1
fi

if ! command -v opclaude-proxy >/dev/null 2>&1; then
  echo "opclaude-proxy not found on PATH. Re-run install.sh." >&2
  exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
  echo "opclaude is not set up yet. Run install.sh first." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

opclaude-proxy ensure || exit 1

# Claude Code defaults to its own model names (e.g. claude-sonnet-4-6), which
# don't exist on this proxy and produce a confusing 400 error. Default to the
# `default:` from models.yaml unless the user passes their own --model.
DEFAULT_MODEL="$(models_py default)" || exit 1
has_model_flag=0
for arg in "$@"; do
  case "$arg" in
    --model|--model=*) has_model_flag=1; break ;;
  esac
done

model_args=()
if [ "$has_model_flag" -eq 0 ]; then
  model_args=(--model "$DEFAULT_MODEL")
fi

exec env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:4000" \
  ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY" \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 \
  claude "${model_args[@]+"${model_args[@]}"}" "$@"
