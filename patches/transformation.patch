+    def _streaming_chunk_has_content(self, choices: List[Any]) -> bool:
+        """Return True if a streaming chunk carries any emittable content.
+
+        Used to distinguish a *pure usage trailer* (usage present, no content,
+        ``finish_reason=None``, non-empty ``choices``) from a real content
+        delta. Some OpenAI-compatible providers (e.g. minimax via opencode
+        zen) emit the usage trailer as a chunk with ``choices=[<empty delta>]``
+        rather than the empty-``choices`` shape OpenAI itself uses, so the
+        ``not response.choices`` base case below doesn't catch it and it would
+        otherwise be translated into a spurious empty ``content_block_delta``
+        after the stream has already ended.
+        """
+        for choice in choices:
+            delta = getattr(choice, "delta", None)
+            if delta is None:
+                continue
+            if getattr(delta, "content", None):
+                return True
+            if getattr(delta, "tool_calls", None):
+                return True
+            if getattr(delta, "reasoning_content", None):
+                return True
+            if getattr(delta, "thinking_blocks", None):
+                return True
+        return False
+
